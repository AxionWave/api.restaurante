# Copie para .env (docker compose) ou exporte no shell.
# Os valores DEV devem ser IGUAIS aos do oAuth / Gateway.

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:8091

JWT_SECRET=defaultSecretKeyForJWTTokenGenerationAndValidation
JWT_ISSUER=http://localhost:8080
JWT_AUDIENCE=oauth-api

# Postgres compartilhado (schema orion). Porta 5433 = docker-compose.infra.yml
ConnectionStrings__Default=Host=localhost;Port=5433;Database=base;Username=postgres;Password=postgres;Search Path=orion

EUREKA_URL=http://localhost:8761/eureka/

# Chamadas de serviço ao Core (estoque). BaseUrl direto (sem Gateway); porta 8081 em dev local.
Services__Core__BaseUrl=http://localhost:8081
# Mesmo valor de GATEWAY_INTERNAL_TOKEN configurado no Core/Gateway.
Services__Core__InternalToken=

# Provedor fiscal para importar NF-e pela chave de acesso (modo 3). "none" = desativado.
Services__FiscalNfe__Provider=none
